# GitHub Username (used for getLatestGithubActivity tool)
GITHUB_USERNAME=ahmadshahdev

# Optional: Override default Claude model (defaults to claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
