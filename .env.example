# Google Gemini API Key (used for agent LLM responses with Gemini gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (alternative model for Claude response generation and tool calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (used for vector store embeddings text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Username (used for getLatestGithubActivity tool)
GITHUB_USERNAME=yourusername

# Optional Model Overrides
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
